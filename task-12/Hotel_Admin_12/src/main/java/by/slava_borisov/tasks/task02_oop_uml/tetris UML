@startuml

' === Перечисления (Enums) ===
enum GameState {
  PLAYING
  PAUSED
  GAME_OVER
  MENU
}

enum BlockColor {
  RED
  BLUE
  GREEN
  YELLOW
  CYAN
  MAGENTA
  ORANGE
}

' === Интерфейсы ===
interface Drawable {
  + {abstract} draw(): void
}

interface Movable {
  + {abstract} move(dx: int, dy: int): void
}

interface Collidable {
  + {abstract} checkCollision(other: GameObject): boolean
}

interface Rotatable {
  + {abstract} rotate(): void
}

' === Абстрактные классы ===
abstract class GameObject {
  - position: Position
  - isActive: boolean
  + {abstract} update(): void
  + destroy(): void
}

abstract class Figure {
  - shape: int[][]
  - position: Position
  - color: BlockColor
  + moveLeft(): void
  + moveRight(): void
  + moveDown(): void
  + {abstract} rotate(): void
  + getShape(): int[][]
}

' === Конкретные фигуры ===
class IFigure {
  + rotate(): void
}

class OFigure {
  + rotate(): void
}

class TFigure {
  + rotate(): void
}

class LFigure {
  + rotate(): void
}

class JFigure {
  + rotate(): void
}

class SFigure {
  + rotate(): void
}

class ZFigure {
  + rotate(): void
}

' === Основные классы ===
class Game {
  - gameState: GameState
  - score: int
  - level: int
  - isRunning: boolean
  + startGame(): void
  + pauseGame(): void
  + endGame(): void
  + update(): void
  + checkLines(): void
}

class GameBoard {
  - width: int
  - height: int
  - cells: Cell[][]
  + addFigure(figure: Figure): boolean
  + removeLine(y: int): void
  + isValidPosition(figure: Figure): boolean
  + clearBoard(): void
}

class Cell {
  - x: int
  - y: int
  - isFilled: boolean
  - color: BlockColor
  + fill(color: BlockColor): void
  + clear(): void
  + setColor(color: BlockColor): void
}

class ScoreManager {
  - currentScore: int
  - highScore: int
  + addPoints(points: int): void
  + updateHighScore(): void
  + resetScore(): void
}

class LevelManager {
  - currentLevel: int
  - linesCleared: int
  - speed: int
  + increaseLevel(): void
  + updateSpeed(): void
}

class GameRenderer {
  - graphicsContext: Object
  + renderBoard(board: GameBoard): void
  + renderFigure(figure: Figure): void
  + renderScore(score: int): void
}

class InputHandler {
  - keyMap: Map<KeyCode, Boolean>
  + handleKeyPress(key: KeyCode): void
  + handleKeyRelease(key: KeyCode): void
}

class Position {
  - x: int
  - y: int
  + setPosition(x: int, y: int): void
  + getX(): int
  + getY(): int
}

' === Наследование ===
GameObject <|-- Figure

Figure <|-- IFigure
Figure <|-- OFigure
Figure <|-- TFigure
Figure <|-- LFigure
Figure <|-- JFigure
Figure <|-- SFigure
Figure <|-- ZFigure

' === Реализация интерфейсов ===
Figure ..|> Drawable
Figure ..|> Movable
Figure ..|> Rotatable
Figure ..|> Collidable

Cell ..|> Drawable

' === Композиции (сплошной ромб — "часть целого") ===
Game *-- "1" GameBoard : contains
Game *-- "1" ScoreManager : contains
Game *-- "1" LevelManager : contains
GameBoard *-- "*" Cell : consists of

' === Агрегации (пустой ромб — "использует") ===
Game o-- "1" GameRenderer : uses
Game o-- "1" InputHandler : uses
Game o-- "1" Figure : currentFigure

' === Ассоциации ===
Game --> "1" GameState : has
Figure --> "1" Position : has
Cell --> "1" BlockColor : has
LevelManager --> "1" Game : manages
InputHandler --> "1" Game : controls

' === Примечания ===
note right of Figure
  Базовый класс для всех тетромино.
  Реализует поведение через интерфейсы.
end note

note top of Game
  Главный контроллер игры.
  Содержит компоненты игры.
  Управляет игровым циклом.
end note

note left of GameBoard
  Представляет игровое поле.
  Содержит сетку ячеек.
  Проверяет коллизии.
end note

@enduml